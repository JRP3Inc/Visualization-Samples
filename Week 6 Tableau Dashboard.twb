    <worksheet name='Profit KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Gourmet Goods Inc Data Set_(1))' name='federated.1pcbonl0sqe17e170g6dg1n1iprc' />
          </datasources>
          <datasource-dependencies datasource='federated.1pcbonl0sqe17e170g6dg1n1iprc'>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column caption='Total CY Profit' datatype='real' name='[Total CY Sales (copy)_875950168260276228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if year([Order Date]) = {max(year([Order Date]))} then [Profit] END' />
            </column>
            <column caption='Total PY Profit' datatype='real' name='[Total PY Sales (copy)_875950168260407301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if YEAR([Order Date])= {max(YEAR([Order Date]))}-1 then Profit end' />
            </column>
            <column caption='YOY Profit' datatype='real' name='[YOY Sales (copy)_875950168260513798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total CY Sales (copy)_875950168260276228])-SUM([Total PY Sales (copy)_875950168260407301]))/sum([Total PY Sales (copy)_875950168260407301])' />
            </column>
            <column caption='YOY Profit Indicator' datatype='string' name='[YOY Sales Indicator (copy)_875950168260653063]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [YOY Sales (copy)_875950168260513798] &gt;0 then &quot;▲&quot; else &quot;▼&quot; end' />
            </column>
            <column-instance column='[Total CY Sales (copy)_875950168260276228]' derivation='Sum' name='[sum:Total CY Sales (copy)_875950168260276228:qk]' pivot='key' type='quantitative' />
            <column-instance column='[YOY Sales (copy)_875950168260513798]' derivation='User' name='[usr:YOY Sales (copy)_875950168260513798:qk]' pivot='key' type='quantitative' />
            <column-instance column='[YOY Sales Indicator (copy)_875950168260653063]' derivation='User' name='[usr:YOY Sales Indicator (copy)_875950168260653063:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1pcbonl0sqe17e170g6dg1n1iprc].[sum:Total CY Sales (copy)_875950168260276228:qk]' value='c&quot;$&quot;0,K;(&quot;$&quot;0,K)' />
            <format attr='text-format' field='[federated.1pcbonl0sqe17e170g6dg1n1iprc].[usr:YOY Sales (copy)_875950168260513798:qk]' value='p0.00%' />
            <format attr='height' value='128' />
            <format attr='width' value='179' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1pcbonl0sqe17e170g6dg1n1iprc].[sum:Total CY Sales (copy)_875950168260276228:qk]' />
              <text column='[federated.1pcbonl0sqe17e170g6dg1n1iprc].[usr:YOY Sales (copy)_875950168260513798:qk]' />
              <text column='[federated.1pcbonl0sqe17e170g6dg1n1iprc].[usr:YOY Sales Indicator (copy)_875950168260653063:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#55aa00' fontname='Tableau Bold' fontsize='12'>Total Profit</run>
                <run>Æ&#10;</run>
                <run fontcolor='#499894' fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.1pcbonl0sqe17e170g6dg1n1iprc].[sum:Total CY Sales (copy)_875950168260276228:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#ba9582' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.1pcbonl0sqe17e170g6dg1n1iprc].[usr:YOY Sales Indicator (copy)_875950168260653063:nk]> <[federated.1pcbonl0sqe17e170g6dg1n1iprc].[usr:YOY Sales (copy)_875950168260513798:qk]>]]></run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='cell'>
                <format attr='text-align' value='center' />
                <format attr='vertical-align' value='center' />
              </style-rule>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
