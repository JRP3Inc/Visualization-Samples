      <aliases enabled='yes' />
      <column caption='Total CY Sales' datatype='real' name='[Calculation_875950168251740160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if year([Order Date]) = {max(year([Order Date]))} then [Sales] END' />
      </column>
      <column caption='Total PY Sales' datatype='real' name='[Calculation_875950168253927425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if YEAR([Order Date])= {max(YEAR([Order Date]))}-1 then [Sales] end' />
      </column>
      <column caption='YOY Sales' datatype='real' name='[Calculation_875950168254943234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_875950168251740160])-SUM([Calculation_875950168253927425]))/sum([Calculation_875950168253927425])' />
      </column>
      <column caption='YOY Sales Indicator' datatype='string' name='[Calculation_875950168258895875]' role='measure' type='nominal'>
